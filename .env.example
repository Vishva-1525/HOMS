VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER commit or expose in the frontend. Used by local scripts only.
# Create at: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for scripts/bulk-import-auth-users.mjs
SUPABASE_URL=

# Supabase CLI (link / db push / functions deploy)
# Create at: https://supabase.com/dashboard/account/tokens
# Then: export SUPABASE_ACCESS_TOKEN=...   (or add to a local .env that you source)
SUPABASE_ACCESS_TOKEN=

# Web Push (generate with: node scripts/setup-web-push.mjs)
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# Must be the SAME key pair as VITE_VAPID_PUBLIC_KEY:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hostel@svce.ac.in
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SVCEHM

# Also set in public.system_settings (SQL) for server-side dispatch when no client is online:
#   supabase_functions_url = https://<project-ref>.supabase.co/functions/v1
#   supabase_anon_key = <anon key>
# See docs/WEB_PUSH_SETUP.md
